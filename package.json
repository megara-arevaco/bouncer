{
  "name": "bouncer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "dev": "tsx apps/playground/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "predev": "npm run build -w @bouncer/api && npm run build -w @bouncer/react"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.15.0",
    "vite": "^7.1.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.56.0"
  }
}
