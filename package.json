{
  "name": "bouncer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "dev": "tsx apps/playground/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "predev": "npm run build -w @bouncer/api && npm run build -w @bouncer/react",
    "docs:check": "node scripts/check-diagrams.mjs",
    "release:pack": "npm run build && node scripts/pack-release.mjs",
    "release:check": "node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "mermaid": "^12.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=24.7.0"
  }
}
