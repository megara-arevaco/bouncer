{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@bouncer/api": ["./packages/api/src/index.ts"],
      "@bouncer/react": ["./packages/react/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps", "tests", "playwright.config.ts"]
}
